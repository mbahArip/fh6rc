{
  "name": "@fh6rc/ui",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ui": "bunx --bun shadcn@latest && bun scripts/generate-index.ts",
    "add": "bunx --bun shadcn@latest add",
    "postadd": "bun scripts/generate-index.ts",
    "gen-index": "bun scripts/generate-index.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check-types": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@fh6rc/biome-config": "workspace:*",
    "@fh6rc/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@tabler/icons-react": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next-themes": "^0.4.6",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./icons": "./src/icons.ts",
    "./globals.css": "./src/styles/globals.css",
    "./postcss.config": "./postcss.config.mjs",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": [
      "./src/hooks/*.ts",
      "./src/hooks/*.tsx"
    ],
    "./components/*": "./src/components/*.tsx"
  }
}
