{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Universal Radio Companion",
  "version": "0.1.0",
  "identifier": "com.mbaharip.fh6rc",
  "build": {
    "beforeDevCommand": "bun run vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Universal Radio Companion",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "decorations": false,
        "theme": "Dark",
        "backgroundColor": [
          9,
          9,
          11,
          255
        ]
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
